// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement()) 
  name  String  @unique
  password String
  bio String?
  image String?
  messagesSent Message[] @relation("Sender")
  messagesReceived Message[] @relation("Receiver")
  followedBy User[] @relation("friends")
  following User[] @relation("friends")
}

model Message { 
  id        Int     @id @default(autoincrement()) 
  body      String
  createdAt DateTime @default(now())
  authorId  Int
  receiverId Int
  author    User    @relation("Sender", fields: [authorId], references: [id])
  recipient User    @relation("Receiver", fields: [receiverId], references: [id])
  
  @@index([authorId, receiverId])
} 